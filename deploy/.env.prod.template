# =============================================================================
# RevPulse — .env PRODUCTION (VPS)
# Copier : cp .env.prod.template .env && éditer chaque valeur ci-dessous.
# Toutes les valeurs marquées ⚠️ OBLIGATOIRE doivent être renseignées.
# =============================================================================

# --- Domaine + TLS (Caddy auto-HTTPS) ---
# ⚠️ OBLIGATOIRE : ton domaine pointant vers le VPS (A record configuré).
DOMAIN=revpulse.exemple.com
# ⚠️ OBLIGATOIRE : email pour Let's Encrypt (notifications expiration).
ACME_EMAIL=admin@revpulse.exemple.com

# --- Environnement ---
REVPULSE_ENV=production

# --- BDD Postgres ---
POSTGRES_USER=revpulse
# ⚠️ OBLIGATOIRE : mot de passe fort (génère : python -c "import secrets; print(secrets.token_urlsafe(32))")
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=revpulse

# --- Sécurité JWT + chiffrement ---
# ⚠️ OBLIGATOIRE : secret JWT HS256 (≥32 chars). Génère : python -c "import secrets; print(secrets.token_urlsafe(48))"
REVPULSE_JWT_SECRET=CHANGE_ME_jwt_secret_minimum_32_chars
# ⚠️ OBLIGATOIRE : clé Fernet base64-urlsafe 32 bytes. Génère : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REVPULSE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_fernet_key
# (optionnel) clé précédente pour rotation — laisser vide si pas de rotation.
REVPULSE_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- App URL + CORS ---
REVPULSE_APP_BASE_URL=https://revpulse.exemple.com
REVPULSE_CORS_ORIGINS=https://revpulse.exemple.com
REVPULSE_JWT_EXPIRY_HOURS=24

# --- Compte démo ---
# ⚠️ En PROD RÉELLE : laisser DEMO_ENABLED=false (sécurité — pas de login démo 1 clic).
REVPULSE_DEMO_ENABLED=false
REVPULSE_DEMO_EMAIL=demo@revpulse.io
REVPULSE_DEMO_PASSWORD=CHANGE_demo_pwd

# --- Rate limiting ---
REVPULSE_RATE_LIMIT_ENABLED=true
REVPULSE_LOGIN_RATE_LIMIT=5/minute

# --- LinkedIn OAuth (RÉEL) ---
# ⚠️ Pour activer le vrai OAuth LinkedIn (vs mock) :
# 1. Crée une app sur https://www.linkedin.com/developers/apps
# 2. Ajoute le produit "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# 3. URL de redirection autorisée : https://revpulse.exemple.com/api/linkedin/callback
# 4. Renseigne Client ID + Client Secret ci-dessous.
# Docs : https://learn.microsoft.com/fr-fr/linkedin/shared/authentication/authorization-code-flow
REVPULSE_LINKEDIN_CLIENT_ID=CHANGE_linkedin_client_id
REVPULSE_LINKEDIN_CLIENT_SECRET=CHANGE_linkedin_client_secret
REVPULSE_LINKEDIN_REDIRECT_URI=https://revpulse.exemple.com/api/linkedin/callback
# MOCK=false → vrai OAuth. true → connexion factice (dev/CI uniquement).
REVPULSE_LINKEDIN_MOCK=false

# --- SMTP (envoi réel des e-mails d'invitation) ---
# ⚠️ Pour activer l'envoi réel :
# - Test : Mailtrap (https://mailtrap.io) — gratuit, captures les e-mails sans envoi réel.
# - Prod : Brevo/Mailgun/SendGrid/Amazon SES.
REVPULSE_SMTP_ENABLED=true
REVPULSE_SMTP_HOST=smtp.mailtrap.io
REVPULSE_SMTP_PORT=587
REVPULSE_SMTP_USER=CHANGE_smtp_user
REVPULSE_SMTP_PASSWORD=CHANGE_smtp_password
REVPULSE_SMTP_FROM=no-reply@revpulse.exemple.com
REVPULSE_SMTP_USE_TLS=true

# --- Stripe (billing réel) ---
# ⚠️ Pour activer le billing réel :
# 1. Crée un compte Stripe : https://dashboard.stripe.com
# 2. TEST mode : utilise les clés de test (sk_test_..., whsec_...).
# 3. Webhook : Endpoint https://revpulse.exemple.com/api/billing/webhook (events: checkout.session.completed, customer.subscription.*)
# Docs : https://stripe.com/docs/keys + https://stripe.com/docs/webhooks
REVPULSE_STRIPE_ENABLED=true
REVPULSE_STRIPE_SECRET_KEY=sk_test_CHANGE_stripe_secret_key
REVPULSE_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_stripe_webhook_secret
REVPULSE_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_stripe_publishable_key

# --- Provider IA (génération de contenu GLM/OpenAI/Anthropic) ---
# ⚠️ La génération de posts LinkedIn (POST /content-studio/posts/generate) nécessite une clé provider IA.
# Configuré PAR TENANT via l'UI : Paramètres → IA providers → ajouter une clé (chiffrée Fernet au repos).
# Pas de variable d'env globale — chaque workspace configure sa propre clé.
# Providers supportés : glm, openai, anthropic (voir schemas.SUPPORTED_PROVIDERS).

# --- Observabilité (optionnel) ---
# Pour activer Prometheus + Grafana + Loki : docker compose -f docker-compose.observability.yml up -d
