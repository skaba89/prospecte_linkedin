# RevPulse stack — variables d'environnement
# Copier en .env et adapter (le JWT secret DOIT être changé en production).

# Secret de signature des JWT (HS256) — OBLIGATOIRE à changer en prod
REVPULSE_JWT_SECRET=change-me-in-production

# Connexion BDD (Postgres du compose par défaut ; sqlite en local)
REVPULSE_DATABASE_URL=postgresql+psycopg2://revpulse:revpulse@db:5432/revpulse

# Origines CORS autorisées (séparées par des virgules)
REVPULSE_CORS_ORIGINS=*

# Durée de validité du JWT (heures)
REVPULSE_JWT_EXPIRY_HOURS=24

# Identifiants du compte démo (recréés idempotemment par le seed)
REVPULSE_DEMO_EMAIL=demo@revpulse.io
REVPULSE_DEMO_PASSWORD=demo1234
