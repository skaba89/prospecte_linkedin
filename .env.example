# RevPulse stack — variables d'environnement
# Copier en .env et adapter. ⚠️ En production (REVPULSE_ENV=production), le JWT secret
# DOIT être ≥ 32 caractères et non défaut — sinon le backend crash au démarrage (fail-fast).

# Environnement : development | test | production (pilote le fail-fast JWT).
REVPULSE_ENV=development

# Secret de signature des JWT (HS256) — OBLIGATOIRE en production (≥ 32 chars).
# Génère un vrai secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
REVPULSE_JWT_SECRET=change-me-in-production

# Connexion BDD (Postgres du compose par défaut ; sqlite en local)
REVPULSE_DATABASE_URL=postgresql+psycopg2://revpulse:revpulse@db:5432/revpulse

# URL publique de l'app (utilisée pour les liens d'invitation e-mail)
REVPULSE_APP_BASE_URL=http://localhost:8080

# Origines CORS autorisées (séparées par des virgules)
REVPULSE_CORS_ORIGINS=*

# Durée de validité du JWT (heures)
REVPULSE_JWT_EXPIRY_HOURS=24

# Identifiants du compte démo (recréés idempotemment par le seed)
REVPULSE_DEMO_EMAIL=demo@revpulse.io
REVPULSE_DEMO_PASSWORD=demo1234

# Rate-limiting login (anti brute-force). Désactivable, configurable (slowapi).
REVPULSE_RATE_LIMIT_ENABLED=true
REVPULSE_LOGIN_RATE_LIMIT=5/minute

# SMTP — envoi réel des e-mails d'invitation. Désactivé par défaut (dry-run = log).
# Pour activer : renseigner host/port/user/password/from et passer smtp_enabled=true.
REVPULSE_SMTP_ENABLED=false
REVPULSE_SMTP_HOST=
REVPULSE_SMTP_PORT=587
REVPULSE_SMTP_USER=
REVPULSE_SMTP_PASSWORD=
REVPULSE_SMTP_FROM=no-reply@revpulse.io
REVPULSE_SMTP_USE_TLS=true

# Stripe — P70-fix : stripe_enabled (défaut true). Pour Docker local / dev sans compte Stripe,
# passer à false → routes billing en mode mock (simulated=True), webhook sans vérif signature.
# ⚠️ En production RÉELLE : laisser true + renseigner STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET
#    (sinon fail-fast au démarrage : anti free-plan-bypass P0-S3/S4).
REVPULSE_STRIPE_ENABLED=true
REVPULSE_STRIPE_SECRET_KEY=
REVPULSE_STRIPE_WEBHOOK_SECRET=
REVPULSE_STRIPE_PUBLISHABLE_KEY=
REVPULSE_STRIPE_API_VERSION=2024-06-20
REVPULSE_STRIPE_CURRENCY=eur

# LinkedIn OAuth 2.0 — laisser vide pour le mode mock (dev/CI sans App LinkedIn).
# Pour une connexion RÉELLE : créer une App sur https://www.linkedin.com/developers/apps
# puis renseigner Client ID / Secret et l'URL de callback ci-dessous.
# ⚠️ L'URL de redirect DOIT être enregistrée à l'identique dans l'App LinkedIn :
REVPULSE_LINKEDIN_CLIENT_ID=
REVPULSE_LINKEDIN_CLIENT_SECRET=
REVPULSE_LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
# Force le mock même si des creds sont présentes (tests / démo) :
REVPULSE_LINKEDIN_MOCK=false
